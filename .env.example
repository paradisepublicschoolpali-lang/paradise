# ===============================================
# PARADISE PUBLIC SCHOOL - SUPABASE CONFIGURATION
# ===============================================
# Obtain these from your Supabase Dashboard: Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ===============================================
# EMAIL DISPATCH CONFIGURATION (Optional Cloud Gateways)
# ===============================================
# Free Web3Forms access key from https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Or EmailJS credentials from https://emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Or Custom REST Webhook URL
VITE_EMAIL_WEBHOOK_URL=

