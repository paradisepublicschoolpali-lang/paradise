# Paradise Public School ERP - Server Environment Variables

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paradise_school_erp?schema=public"

# Authentication Secrets
JWT_SECRET="paradise_public_school_super_secure_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="paradise_public_school_refresh_token_secret_key_2026"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:5173,http://localhost:4173,http://localhost:8081"

# Notification Services (Firebase Cloud Messaging / Expo Push)
EXPO_ACCESS_TOKEN=""
FCM_SERVER_KEY=""

# Storage Services (AWS S3 / Supabase Storage)
STORAGE_BUCKET="paradise-school-documents"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
